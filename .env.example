# Base Sepolia only. Never commit a real key or paste one into chat.
# Use a dedicated testnet-only wallet with no mainnet funds.
OFR_BASE_SEPOLIA_PRIVATE_KEY=0xYOUR_DEDICATED_TESTNET_PRIVATE_KEY

# Optional read-only preflight address. Use this before adding the private key.
# OFR_ATTESTER_ADDRESS=0xYOUR_DEDICATED_TESTNET_ADDRESS

# A dedicated provider URL is optional for the six-receipt pilot. The public
# Base endpoint is rate-limited and remains the default when this is omitted.
OFR_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Both values are required in addition to --submit before a script can write.
OFR_ALLOW_BASE_SEPOLIA_WRITE=I_UNDERSTAND_THIS_WRITES_TO_BASE_SEPOLIA

# Hard transaction safety ceiling in wei. Review the live preflight and convert
# the approved USD batch budget to wei before every write. A write is rejected
# when this value is absent or below the estimated total Base fee (L1 + L2).
# OFR_MAX_TOTAL_FEE_WEI=500000000000000

# Public Firestore web configuration for OFLAPP-STAGING. Firebase web config is
# not a secret; Firestore Security Rules enforce anonymous read-only access.
# npm run dev uses .env.staging.local and never starts a local emulator.
# VITE_FIREBASE_PROJECT_ID=oflapp-staging
# VITE_FIREBASE_API_KEY=PUBLIC_FIREBASE_WEB_API_KEY
# VITE_FIREBASE_AUTH_DOMAIN=oflapp-staging.firebaseapp.com
# VITE_FIREBASE_APP_ID=PUBLIC_FIREBASE_WEB_APP_ID
# VITE_OFL_YOUTUBE_VIDEO_URL=https://youtu.be/YOUR_VIDEO_ID

# Production signer direction. The private key is created inside Cloud KMS and
# never exported; this value identifies the exact key version to call.
# OFR_KMS_KEY_VERSION=projects/oflapp-prod/locations/global/keyRings/ofl-attester/cryptoKeys/base-attester/cryptoKeyVersions/1

# A cloud Firestore import needs two deliberate gates:
# OFR_CONFIRM_FIRESTORE_PROJECT=oflapp-staging npm run firestore:seed:staging

# Optional only when the explorer is built below a first-party URL prefix.
# Native's root-hosted preview should leave this unset.
# VITE_BASE_PATH=/tools/open-forecast-receipt/

# Used only to generate the verified iPulse catalog handoff after issuance.
# Override this if the public explorer is hosted at a different HTTPS origin.
# OFR_PUBLIC_EXPLORER_BASE_URL=https://ipulseai.com/tools/open-forecast-receipt
