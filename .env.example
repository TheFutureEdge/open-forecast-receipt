# Base Sepolia only. Never commit a real key or paste one into chat.
# Use a dedicated testnet-only wallet with no mainnet funds.
OFR_BASE_SEPOLIA_PRIVATE_KEY=0xYOUR_DEDICATED_TESTNET_PRIVATE_KEY

# Optional read-only preflight address. Use this before adding the private key.
# OFR_ATTESTER_ADDRESS=0xYOUR_DEDICATED_TESTNET_ADDRESS

# A dedicated provider URL is optional for the six-receipt pilot. The public
# Base endpoint is rate-limited and remains the default when this is omitted.
OFR_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Both values are required in addition to --submit before a script can write.
OFR_ALLOW_BASE_SEPOLIA_WRITE=I_UNDERSTAND_THIS_WRITES_TO_BASE_SEPOLIA

# Optional only when the explorer is built below a first-party URL prefix.
# Native's root-hosted preview should leave this unset.
# VITE_BASE_PATH=/tools/open-forecast-receipt/

# Used only to generate the verified iPulse catalog handoff after issuance.
# Override this if the public explorer is hosted at a different HTTPS origin.
# OFR_PUBLIC_EXPLORER_BASE_URL=https://ipulseai.com/tools/open-forecast-receipt
