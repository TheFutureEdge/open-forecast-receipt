rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /public_catalog_state/current {
      allow get: if true;
      allow list, write: if false;
    }

    // Incomplete builds are private. Retained ready versions remain readable
    // so a visitor can finish paging the version rendered by the server.
    match /public_catalog_generations/{generationId}/{catalog}/{documentId} {
      function ready() {
        return get(/databases/$(database)/documents/public_catalog_generations/$(generationId)).data.status == 'ready';
      }
      allow get: if ready() && catalog in [
        'public_collections', 'public_targets', 'public_forecasters',
        'public_collection_catalogs', 'public_entity_directory_catalogs',
        'public_entity_forecast_catalogs', 'public_entity_forecast_ledgers',
        'public_forecaster_catalogs', 'public_library_stats'
      ];
      allow list, write: if false;
      match /parts/{partId} {
        allow get: if ready() && catalog == 'public_entity_forecast_ledgers';
        allow list: if ready() && catalog == 'public_entity_forecast_ledgers'
          && request.query.limit != null && request.query.limit <= 2;
        allow write: if false;
      }
    }

    // Public Library records live in dedicated public namespaces. The browser
    // can read them anonymously, but no web or mobile client can create,
    // update, or delete them. Controlled publishers use the Admin SDK and IAM.
    match /public_collections/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_collection_entities/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_collection_catalogs/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_entity_directory_catalogs/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_entity_forecast_catalogs/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_entity_forecast_ledgers/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;

      match /parts/{partId} {
        allow get: if true;
        // The ledger UI reads exactly the newest two bounded parts and then
        // paginates two at a time. Reject unbounded client-side scans.
        allow list: if request.query.limit != null && request.query.limit <= 2;
        allow write: if false;
      }
    }

    match /public_entities/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_forecasters/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_forecaster_catalogs/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_publishers/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_targets/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_forecast_revisions/{documentId} {
      allow get: if true;
      allow list, write: if false;
    }

    match /public_forecast_resolvers/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_receipt_resolvers/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_library_stats/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Sitemap catalogs are server-rendering infrastructure. They are not a
    // browser data API and remain protected by the default deny rule below.

    match /public_forecasts/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_receipts/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /public_proofs/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Jobs, publisher runs, signer state, and any future non-public data are
    // inaccessible to clients. Server access is controlled by Google Cloud IAM.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
