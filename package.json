{
  "name": "open-forecast-receipt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "dotenv -e .env.staging.local -- next dev",
    "dev:web": "next dev",
    "build": "next build",
    "build:staging": "dotenv -e .env.staging.local -- next build",
    "build:production": "dotenv -e .env.production.local -- next build",
    "start": "next start",
    "preview": "next start",
    "test": "vitest run",
    "readiness:check": "node scripts/check-production-readiness.mjs",
    "firestore:seed:staging": "node scripts/seed-firestore.mjs --project=oflapp-staging --apply",
    "showcase:plan": "node scripts/seed-firestore.mjs --project=oflapp-staging",
    "showcase:sync:staging": "OFR_CONFIRM_FIRESTORE_PROJECT=oflapp-staging node scripts/seed-firestore.mjs --project=oflapp-staging --apply",
    "entities:snapshot": "node scripts/sync-ipulse-entity-catalog.mjs",
    "entities:sync:staging": "OFR_CONFIRM_FIRESTORE_PROJECT=oflapp-staging node scripts/sync-ipulse-entity-catalog.mjs --project=oflapp-staging --apply",
    "catalogs:plan:staging": "node scripts/materialize-public-catalogs.mjs --project=oflapp-staging",
    "catalogs:plan:production": "node scripts/materialize-public-catalogs.mjs --project=oflapp-prod",
    "catalogs:sync:staging": "OFR_CONFIRM_FIRESTORE_PROJECT=oflapp-staging node scripts/materialize-public-catalogs.mjs --project=oflapp-staging --apply",
    "publish:bundle": "node scripts/publish-library-bundle.mjs",
    "publish:ipulse-batch": "node scripts/publish-ipulse-batch.mjs",
    "smoke:staging": "node --env-file=.env.staging.local scripts/smoke-staging.mjs",
    "fixtures:phase1": "node scripts/generate-phase1-fixtures.mjs",
    "fixtures:reseal-entity-contract": "node scripts/reseal-entity-contract-fixtures.mjs",
    "eas:preflight": "node --env-file-if-exists=.env.local scripts/eas-showcase.mjs preflight",
    "eas:schema:register": "node --env-file-if-exists=.env.local scripts/eas-showcase.mjs register",
    "eas:showcase:issue": "node --env-file-if-exists=.env.local scripts/eas-showcase.mjs issue",
    "eas:showcase:verify": "node --env-file-if-exists=.env.local scripts/eas-showcase.mjs verify",
    "eas:showcase:sync": "node --env-file-if-exists=.env.local scripts/eas-showcase.mjs sync",
    "native:prepare-upload": "node scripts/prepare-native-upload.mjs",
    "native:check-upload": "node scripts/prepare-native-upload.mjs --check"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.11.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "firebase": "^12.17.1",
    "json-canonicalize": "^2.0.0",
    "nanoid": "3.3.18",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.1.18",
    "viem": "2.55.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.14",
    "@types/react-dom": "^19.0.6",
    "dotenv-cli": "^11.0.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
