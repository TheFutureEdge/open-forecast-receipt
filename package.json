    "eas:showcase:issue": "node --env-file-if-exists=.env.local scripts/eas-showcase.mjs issue",
    "eas:showcase:verify": "node --env-file-if-exists=.env.local scripts/eas-showcase.mjs verify",
    "eas:showcase:sync": "node --env-file-if-exists=.env.local scripts/eas-showcase.mjs sync",
